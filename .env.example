# Telegram Bot Token (t.me/BotFather orqali olingan)
BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE

# Super Admin Telegram ID (faqat bu ID egasi boshqa adminlarni qo'sha oladi)
SUPER_ADMIN_ID=123456789

# Instagram uchun cookies.txt fayl manzili (ixtiyoriy, login talab qiladigan videolar uchun)
IG_COOKIES_PATH=cookies.txt

# Rate limit sozlamalari (Foydalanuvchi boshiga so'rovlar soni va vaqt oralig'i)
RATE_LIMIT_LIMIT=5
RATE_LIMIT_WINDOW=60
